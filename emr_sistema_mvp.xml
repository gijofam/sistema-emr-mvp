import { useEffect, useState } from 'react'
import { BrandMark } from '../components/BrandMark'
import { ContinueButton, SceneFrame } from '../components/SceneFrame'
import './IntroScene.css'

const FIRST_LINE = 'No todos llegan hasta aquí.'
const SECOND_LINE = 'Tú sí.'
const LOGO_MS = 2600
const LOGO_PAUSE_MS = 500
const CHARACTER_MS = 42
const LINE_PAUSE_MS = 550
const SECOND_CHARACTER_MS = 55
const BUTTON_PAUSE_MS = 750

const reducedMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches

export function IntroScene({ onContinue }) {
  const [firstLength, setFirstLength] = useState(() => reducedMotion() ? FIRST_LINE.length : 0)
  const [secondLength, setSecondLength] = useState(() => reducedMotion() ? SECOND_LINE.length : 0)
  const [showButton, setShowButton] = useState(() => reducedMotion())

  useEffect(() => {
    if (reducedMotion()) return undefined

    const timers = []
    const firstStart = LOGO_MS + LOGO_PAUSE_MS
    const secondStart = firstStart + FIRST_LINE.length * CHARACTER_MS + LINE_PAUSE_MS
    const buttonStart = secondStart + SECOND_LINE.length * SECOND_CHARACTER_MS + BUTTON_PAUSE_MS

    for (let index = 1; index <= FIRST_LINE.length; index += 1) {
      timers.push(window.setTimeout(() => setFirstLength(index), firstStart + index * CHARACTER_MS))
    }
    for (let index = 1; index <= SECOND_LINE.length; index += 1) {
      timers.push(window.setTimeout(() => setSecondLength(index), secondStart + index * SECOND_CHARACTER_MS))
    }
    timers.push(window.setTimeout(() => setShowButton(true), buttonStart))

    return () => timers.forEach(window.clearTimeout)
  }, [])

  return (
    <SceneFrame className="scene--intro">
      <div className="intro-logo" aria-label="ELMACHORENACE">
        <div className="intro-logo__final" aria-hidden="true"><BrandMark /></div>
        <div className="intro-logo__pieces" aria-hidden="true">
          {Array.from({ length: 6 }, (_, index) => (
            <div className={`intro-logo__piece intro-logo__piece--${index + 1}`} key={index}>
              <BrandMark />
            </div>
          ))}
        </div>
      </div>
      <p className="intro-copy intro-typewriter" aria-label={`${FIRST_LINE} ${SECOND_LINE}`}>
        <span aria-hidden="true">{FIRST_LINE.slice(0, firstLength)}</span>
        <br />
        <strong aria-hidden="true">{SECOND_LINE.slice(0, secondLength)}</strong>
      </p>
      <div className="intro-button-slot">
        {showButton && <div className="intro-button-enter"><ContinueButton onClick={onContinue} /></div>}
      </div>
    </SceneFrame>
  )
}
</file>

