export function ReferralScene({ token, onContinue }) {
  const [referral, setReferral] = useState({ personasIniciadas: 0, objetivo: 5, codigoReferido: null })
  const [feedback, setFeedback] = useState('')
  useEffect(() => { api.getReferral(token).then(setReferral).catch(() => {}) }, [token])

  const invite = async () => {
    try {
      const result = await api.createReferral(token)
      setReferral(result)
      const url = `${window.location.origin}/c/${token}?ref=${result.codigoReferido}`
      if (navigator.share) await navigator.share({ title: 'Comienza tu camino EMR', text: 'Alguien más podría necesitar comenzar.', url })
      else {
        await navigator.clipboard.writeText(url)
        setFeedback('Enlace de invitación copiado.')
      }
    } catch (error) {
      if (error?.name !== 'AbortError') setFeedback(error.message || 'No pudimos preparar la invitación.')
    }
  }

  const percent = Math.min(100, (referral.personasIniciadas / referral.objetivo) * 100)
  return (
    <SceneFrame className="scene--referral">
      <h1>Alguien más podría necesitar comenzar.</h1>
      <ContinueButton onClick={invite}>INVITAR A ALGUIEN</ContinueButton>
      <p>Si alguien inicia su camino en EMR gracias a ti,<br />comenzaremos a registrar tu impacto.</p>
      <span className="eyebrow">PERSONAS QUE COMENZARON<br />GRACIAS A TI</span>
      <div className="impact-bar" aria-label={`${referral.personasIniciadas} de ${referral.objetivo}`}><i style={{ width: `${percent}%` }} /></div>
      <strong className="impact-count">{referral.personasIniciadas} / {referral.objetivo}</strong>
      <p className="reward">RECOMPENSA SECRETA <span aria-hidden="true">⌁</span></p>
      <p className="feedback" role="status">{feedback}</p>
      <button className="text-action" type="button" onClick={onContinue}>CONTINUAR</button>
    </SceneFrame>
  )
}
